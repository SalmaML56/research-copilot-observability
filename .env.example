ENVIRONMENT=dev
DEEPSEEK_API_KEY=
GROQ_API_KEY=
DEFAULT_MODEL_NAME=deepseek-chat
CHEAP_MODEL_NAME=openai/gpt-oss-20b
MAX_TOKENS=4096
MODEL_PROFILE=primary
PROMPT_VERSION=v1
LANGFUSE_PUBLIC_KEY=pk-lf-local-dev-0000000000000000
LANGFUSE_SECRET_KEY=sk-lf-local-dev-0000000000000000
LANGFUSE_HOST=http://localhost:3000
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Database/service ports (Step: security follow-up per review)
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_API_PORT=9090
MINIO_CONSOLE_PORT=9091
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CHECKPOINT_POSTGRES_PORT=5433

# --- Tracing backend switch (Phase 5, P5-02) ---
# otel     = OpenInference/OTel only (default). Langfuse @observe is a no-op,
#            so tool spans are NOT double-exported. Use this for Phase 5.
# langfuse = Langfuse decorators active (Phase 2 demos).
# both     = both pipelines; accepts 2x tool spans. Only for Steps 26/28.
TRACING_BACKEND=otel

# --- Span attribute limit (Phase 5, P5-01 / review v2 Addendum C) ---
# SDK default is 128. OpenInference flattens each chat message into several
# attributes, so long-context model spans overflowed and the SDK evicted the
# OLDEST attributes first - which is exactly the identity attributes.
OTEL_SPAN_ATTRIBUTE_COUNT_LIMIT=2048

# --- Langfuse first-run provisioning (Phase 5, P5-03 / review v2 Addendum A) ---
# Without these, a fresh `docker compose up` creates a Langfuse database with
# 0 projects and 0 API keys, and every span export fails with 401. These are
# LOCAL DEV ONLY values for a localhost-bound container - never reuse them
# for anything reachable from outside this machine.
LANGFUSE_INIT_ORG_ID=research-copilot-local
LANGFUSE_INIT_ORG_NAME=Research Copilot (local)
LANGFUSE_INIT_PROJECT_ID=research-copilot-dev
LANGFUSE_INIT_PROJECT_NAME=research-copilot
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-local-dev-0000000000000000
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-local-dev-0000000000000000
LANGFUSE_INIT_USER_EMAIL=dev@research-copilot.local
LANGFUSE_INIT_USER_NAME=Local Dev
LANGFUSE_INIT_USER_PASSWORD=local-dev-password

# --- Eval judge (Phase 6, Step 38) ---
# Model that DeepEval uses as LLM-as-judge, served by Groq (needs GROQ_API_KEY).
# Deliberately not the agent's own model (deepseek-chat) so it isn't grading itself.
JUDGE_MODEL_NAME=openai/gpt-oss-120b

# --- Agent checkpoints (Phase 7, Step 46) ---
# Dedicated checkpoint-postgres service, not langfuse-postgres. LOCAL DEV
# ONLY credentials for a localhost-bound container.
CHECKPOINT_DB_URI=postgresql://checkpoints:checkpoints@localhost:5433/checkpoints

# --- Trace sampling (Phase 7, Step 44) ---
# Share of SESSIONS whose traces are kept by the collector's tail sampler
# (errors and model calls over $0.01 are always kept). Decided per session,
# so every trace of one run is kept or dropped together. 1.0 = keep all
# (used by the Step 47 load test).
TRACE_SESSION_SAMPLE_RATE=0.2
